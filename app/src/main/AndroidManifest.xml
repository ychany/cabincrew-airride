<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Pleos Vehicle SDK: only the APIs AirRide uses. -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- Gear selection + steering wheel angle (SDK @RequiresCustomPermission). -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- Vehicle speed (AAOS PERF_VEHICLE_SPEED) → acceleration change for the motion-sickness index. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- Heads-up suggestion over the navigation map (A-06 / A-08). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility for TextToSpeech engines. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirRide">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.AirRide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Usable while driving: Driver Distraction Optimized (AAOS). -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <receiver
            android:name=".notify.SuggestionActionReceiver"
            android:exported="false" />
    </application>
</manifest>
